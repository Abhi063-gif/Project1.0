# GitHub API Configuration (Optional - for higher rate limits)
REACT_APP_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# API URLs (Leave as default)
REACT_APP_GITHUB_API_URL=https://api.github.com
REACT_APP_OSS_INSIGHT_API=https://api.ossinsight.io

# App Configuration
REACT_APP_ITEMS_PER_PAGE=30
REACT_APP_MAX_SEARCH_RESULTS=1000

# App Information
REACT_APP_APP_NAME=GitHub Explorer
REACT_APP_VERSION=1.0.0
